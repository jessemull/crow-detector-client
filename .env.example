# Public build-time settings for the static Critter Canteen site.
# Copy to `.env.local` for local builds. Never commit real secrets.

# Shelter Cam + Feeder Cam. Browser fetches /porch/clips and /feeder/clips.
# Playback allowlist always includes CloudFront, *.crittercanteen.com, and S3
# virtual-hosted object URLs; set NEXT_PUBLIC_PLAYBACK_HOSTS for extra hosts.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PLAYBACK_HOSTS=

# Analytics. Injected only when the id matches G-[A-Z0-9]+ and consent is granted.
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GA_CONSENT=
GA_TRACKING_ID_DEV=
GA_TRACKING_ID_PROD=
GA_CONSENT_DEV=
GA_CONSENT_PROD=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN_SOURCE_MAPS=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT_TEST=
SENTRY_ENVIRONMENT_PROD=

# Deploy. Workflows assume these OIDC roles and read the bucket and region secrets.
AWS_REGION=
AWS_ROLE_TO_ASSUME_DEV=
AWS_ROLE_TO_ASSUME_PROD=
AWS_S3_BUCKET_DEV=
AWS_S3_BUCKET_PROD=
AWS_S3_BUCKET_BACKUP_DEV=
AWS_S3_BUCKET_BACKUP_PROD=
AWS_CLOUDFRONT_DISTRIBUTION_ID_DEV=
AWS_CLOUDFRONT_DISTRIBUTION_ID_PROD=

# Local signed-cookie proxy
CLOUDFRONT_DOMAIN=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

SITE_URL=https://www.crittercanteen.com

# Optional SSH. The CloudFormation stack has no bastion.
SSH_HOST=
SSH_PRIVATE_KEY_PATH=
SSH_USER=

LHCI_GITHUB_APP_TOKEN=
