# Sentry Configuration
# CI build/source-map jobs pass NEXT_PUBLIC_SENTRY_DSN and NEXT_PUBLIC_SENTRY_RELEASE
# (release format: ${SENTRY_ENVIRONMENT_TEST}-${github.sha} or ${SENTRY_ENVIRONMENT_PROD}-${github.sha})
# so client events match uploaded maps. The Node hook reads SENTRY_ENVIRONMENT.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN_SOURCE_MAPS=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org_here
SENTRY_PROJECT=your_sentry_project_here
SENTRY_ENVIRONMENT_TEST=test
SENTRY_ENVIRONMENT_PROD=production

# AWS region for the OIDC deploy role. Workflows no longer take long-lived access keys.
AWS_REGION=us-west-2

# S3 Bucket Names (for CI/CD)
AWS_S3_BUCKET_DEV=crow-detector-client-test
AWS_S3_BUCKET_PROD=crow-detector-client-production
AWS_S3_BUCKET_BACKUP_DEV=crow-detector-client-backup-test
AWS_S3_BUCKET_BACKUP_PROD=crow-detector-client-backup-production

# CloudFront Distribution IDs (for CI/CD)
AWS_CLOUDFRONT_DISTRIBUTION_ID_DEV=your_dev_distribution_id
AWS_CLOUDFRONT_DISTRIBUTION_ID_PROD=your_prod_distribution_id

# CloudFront Configuration (for proxy server)
# Required — proxy fails closed (process.exit(1)) if CLOUDFRONT_DOMAIN is missing.
# Signing also requires CLOUDFRONT_KEY_PAIR_ID and either CLOUDFRONT_PRIVATE_KEY or CLOUDFRONT_PRIVATE_KEY_PATH.
CLOUDFRONT_DOMAIN=www.dev.crittercanteen.com
CLOUDFRONT_PRIVATE_KEY=your_cloudfront_private_key_here
CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id_here
CLOUDFRONT_PRIVATE_KEY_PATH=path/to/your/private/key.pem

# Site Configuration
SITE_URL=https://www.crittercanteen.com

# Shelter Cam + Feeder Cam. Browser fetches /porch/clips and /feeder/feeds.
# Playback allowlist always includes CloudFront, *.crittercanteen.com, and S3
# virtual-hosted object URLs (us-west-2); set NEXT_PUBLIC_PLAYBACK_HOSTS for extras.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PLAYBACK_HOSTS=

# Google Analytics. The tag is injected only when the id matches G-[A-Z0-9]+
# and NEXT_PUBLIC_GA_CONSENT is the literal granted.
GA_TRACKING_ID_DEV=your_dev_ga_tracking_id_here
GA_TRACKING_ID_PROD=your_prod_ga_tracking_id_here
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GA_CONSENT=
GA_CONSENT_DEV=
GA_CONSENT_PROD=

# GitHub Actions OIDC roles. Deploy workflows assume these instead of long-lived keys.
AWS_ROLE_TO_ASSUME_DEV=
AWS_ROLE_TO_ASSUME_PROD=

# Optional SSH. The CloudFormation stack has no bastion. npm run bastion uses these
# only when an operator still has a host to reach.
SSH_HOST=your_bastion_host_ip
SSH_PRIVATE_KEY_PATH=path/to/your/ssh/private/key
SSH_USER=your_bastion_host_username

# Lighthouse CI
LHCI_GITHUB_APP_TOKEN=your_lighthouse_ci_token_here
